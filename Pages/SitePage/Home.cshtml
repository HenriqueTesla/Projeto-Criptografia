@page
@model Projeto_Criptografia.Pages.SitePage.HomeModel
@{
    ViewData["Title"] = "Home";
}

<link rel="stylesheet" href="/home.css" />

<div class="container">
    <h1>Bem-vindo!</h1>
    <p class="subtitle">Login realizado com sucesso. Escolha uma das opções abaixo:</p>

    <div class="cards">
        <div class="card">
            <h3>Perfil</h3>
            <p>Veja informações do usuário, configurações e detalhes da conta.</p>
            <button class="btn">Acessar</button>
        </div>

        <div class="card">
            <h3>Ferramentas</h3>
            <p>Acesse ferramentas e recursos disponíveis no sistema.</p>
            <button class="btn">Acessar</button>
        </div>

        <div class="card">
            <h3>Configurações</h3>
            <p>Gerencie opções visuais, notificações e preferências.</p>
            <button class="btn">Acessar</button>
        </div>
    </div>
</div>