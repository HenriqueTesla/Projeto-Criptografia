@page
@model Projeto_Criptografia.Pages.SitePage.HomeModel
<link rel="stylesheet" href="/home.css" />

<div class="container">
    <h1>Bem-vindo, @Model.Username!</h1>
    <p class="subtitle">Gerencie sua conta abaixo:</p>

    <div class="cards">

        <div class="card">
            <h3>Editar Nome</h3>
            <p>Mude o nome do usuário atual.</p>

            <form method="post">
                <input type="hidden" name="Action" value="Edit" />
                <input type="text" name="NewName" placeholder="Novo nome" required />
                <button class="btn" type="submit">Atualizar</button>
            </form>
        </div>

        <div class="card">
            <h3>Excluir Conta</h3>
            <p>Essa ação é permanente.</p>

            <form method="post" onsubmit="return confirm('Tem certeza que deseja excluir sua conta?');">
                <input type="hidden" name="Action" value="Delete" />
                <button class="btn" style="border-color: #ff5050;" type="submit">Excluir Conta</button>
            </form>
        </div>

    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <p style="margin-top:20px;">@Model.Message</p>
    }
</div>